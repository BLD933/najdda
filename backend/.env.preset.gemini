# ── Google Gemini ────────────────────────────────────────────────────────────
# Free tier is 20 requests/day per model — a NAJDDA message costs ~4 calls,
# so roughly 5 messages/day. Attach billing for real use:
# https://ai.studio.google.com/billing
#
# Uses Gemini's OpenAI-compatible endpoint, so no extra dependency.
# Note: gemini-2.5-pro returns 404 for new projects ("no longer available to
# new users"). gemini-2.5-flash works.

LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_API_KEY=AIzaSy_replace_me
LLM_MODEL_FAST=gemini-2.5-flash
LLM_MODEL_DEEP=gemini-2.5-flash

# REQUIRED for Gemini, harmless for other providers (passed through verbatim).
# Without it, reasoning tokens consume the whole max_tokens budget and the model
# returns truncated prose instead of JSON — a silent failure.
LLM_EXTRA_BODY={"thinkingConfig":{"thinkingBudget":0}}
