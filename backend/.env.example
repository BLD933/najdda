PORT=5000
DATABASE_URL=postgresql://shifaa:shifaa_dev@127.0.0.1:5433/shifaa
JWT_SECRET=generate-with-openssl-rand-hex-32

# Gemini — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# FAST: routing, safety gateway, triage (low latency)
MODEL_FAST=gemini-2.5-flash
# DEEP: diagnosis and final synthesis
# NOTE: gemini-2.5-pro returns 404 for new projects ("no longer available to
# new users"). 3.1-pro-preview is the live equivalent.
MODEL_DEEP=gemini-3.1-pro-preview

# Set to "require" only for hosted Postgres that needs TLS (Neon, Supabase).
# Leave unset for local/docker Postgres, which does not speak SSL.
DATABASE_SSL=

NODE_ENV=development

# Optional — raise OpenFDA rate limits — https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=
# Optional — https://openweathermap.org/api
OPENWEATHER_API_KEY=
