PORT=5000
DATABASE_URL=postgresql://shifaa:shifaa_dev@127.0.0.1:5433/shifaa
JWT_SECRET=generate-with-openssl-rand-hex-32
FRONTEND_URL=http://localhost:5173

# Gemini — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Provider OpenAI-compatible (Groq défaut, voir .env.preset.groq/gemini/ollama)
LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions
LLM_API_KEY=
LLM_MODEL_FAST=qwen/qwen3.8-27b
LLM_MODEL_DEEP=openai/gpt-oss-120b
LLM_EXTRA_BODY=
# FAST: routing, safety gateway, triage (low latency)
MODEL_FAST=gemini-2.5-flash
# DEEP: diagnosis and final synthesis
# NOTE: gemini-2.5-pro returns 404 for new projects ("no longer available to
# new users"). 3.1-pro-preview is the live equivalent.
MODEL_DEEP=gemini-3.1-pro-preview

# Set to "require" only for hosted Postgres that needs TLS (Neon, Supabase).
# Leave unset for local/docker Postgres, which does not speak SSL.
DATABASE_SSL=

NODE_ENV=development

# Optional — raise OpenFDA rate limits — https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=
# Optional — https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Optional — n8n emergency webhook. Import n8n/emergency-workflow.json into n8n,
# activate the workflow, then paste its production URL here:
#   https://n8n.example.com/webhook/emergency-alert
# Leaving it empty disables the WhatsApp alert entirely; the in-app emergency
# response and the 150 call are unaffected.
N8N_EMERGENCY_WEBHOOK_URL=

# Shared secret sent as the `x-n8n-secret` header. The workflow's Code node
# rejects a mismatch, so an unauthenticated caller cannot trigger a WhatsApp
# alert to someone's family. Set the same value as N8N_WEBHOOK_SECRET in n8n's
# environment (Settings → Variables). Use a long random string.
N8N_WEBHOOK_SECRET=

# Read by the workflow itself, not the backend — declare them in n8n's
# environment (Settings → Variables) so they never leave the n8n container.
# GOOGLE_MAPS_API_KEY=   # nearest-hospital lookup; the alert still sends without it
# EVOLUTION_API_KEY=     # Evolution API, for WhatsApp delivery
# EVOLUTION_INSTANCE=
# EVOLUTION_API_BASE_URL=https://evolution-api.example.com
