# ── Local Ollama (no key, unlimited, fully offline) ──────────────────────────
# Patient data never leaves the machine. Costs speed: this box has no NVIDIA
# GPU, so gemma4:4b measures ~5.7s for a 20-token reply on the Intel UHD 620.
# `ollama pull gemma4:4b` if not already present.

LLM_BASE_URL=http://localhost:11434/v1/chat/completions
LLM_API_KEY=ollama
LLM_MODEL_FAST=gemma4:4b
LLM_MODEL_DEEP=gemma4:4b

LLM_EXTRA_BODY=
